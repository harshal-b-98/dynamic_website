# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dynamic_website"

# Supabase (Vector Database)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_KEY="your-service-key"
SUPABASE_ANON_KEY="your-anon-key"

# AI APIs
ANTHROPIC_API_KEY="sk-ant-api03-..."
OPENAI_API_KEY="sk-..."

# CMS Webhook Secrets (for webhook verification)
WORDPRESS_WEBHOOK_SECRET="your-wordpress-secret"
CONTENTFUL_WEBHOOK_SECRET="your-contentful-secret"
SKIP_WEBHOOK_VERIFICATION="false"  # Set to "true" for development only

# NextAuth.js
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# CRM Integrations (optional)
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
SALESFORCE_INSTANCE_URL=""

HUBSPOT_API_KEY=""
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""

PIPEDRIVE_API_KEY=""

# Lead Enrichment (optional)
CLEARBIT_API_KEY=""
ZOOMINFO_API_KEY=""

# Redis (Caching)
REDIS_URL="redis://localhost:6379"

# Sentry (Error Tracking)
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Analytics
VERCEL_ANALYTICS_ID=""

# Email (for transactional emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@yourcompany.com"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Consumer IQ"

# Feature Flags
NEXT_PUBLIC_ENABLE_PERSONALIZATION="true"
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
